{
    "rewrites": [
        {
            "source": "/article/:slug",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Twitterbot|TelegramBot|WhatsApp|LinkedInBot|Slackbot|Discordbot|Googlebot|Pinterest|redditbot|SkypeUriPreview|Embedly).*"
                }
            ],
            "destination": "/api/og/article?slug=:slug"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}